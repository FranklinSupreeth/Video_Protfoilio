# Contact form — SMTP settings.
# Copy this file to `.env.local` for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-character code below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Where new messages are delivered (defaults to SMTP_USER).
CONTACT_TO=your-gmail@gmail.com

# Optional: "From" address (defaults to SMTP_USER). Gmail requires it to be your own address.
# SMTP_FROM=your-gmail@gmail.com

# Your live portfolio URL — used for the "View my work" button in the auto-reply.
SITE_URL=https://franklin-video-protfoilio.vercel.app
